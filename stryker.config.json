{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:arch"
  },
  "mutate": [
    "tests/arch_contract.py"
  ],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
